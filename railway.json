{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python ecommerce_dashboard/manage.py collectstatic --noinput"
  },
  "deploy": {
    "startCommand": "cd ecommerce_dashboard && gunicorn ecommerce_dashboard.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 120 --log-file -",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
